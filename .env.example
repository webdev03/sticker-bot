# in this file there are variables starting with `PUBLIC_`
# these variables can be seen by users because they are used in website code

# the ID of the slack team
SLACK_TEAM="T<add here>"
PUBLIC_SLACK_TEAM_DOMAIN="<add here>.slack.com" # example: hackclub.slack.com

# get this from https://api.slack.com
SLACK_SIGNING_SECRET="<add here>"
SLACK_BOT_TOKEN="xoxb-<add here>"
SLACK_APP_TOKEN="xapp-<add here>"
SLACK_CLIENT_ID="number.number"
SLACK_CLIENT_SECRET="<add here>"

# Deploy imdevarsh/slack-emoji-proxy and create a named API key in its Slack App Home.
# Server-only: never use a PUBLIC_ prefix for the key.
SLACK_EMOJI_PROXY_URL="https://your-proxy.vercel.app"
SLACK_EMOJI_PROXY_TOKEN="<API key>"

# comma-separated list of channels that the bot will work in!
# you will need to add the bot to these channels!
# the first channel in the list will be linked on the website
PUBLIC_SLACK_CHANNELS="C<add here>,C<add here>"

# your Neon DB URL
DATABASE_URL="<add here>"

# random value for jwt signing - use `openssl rand -base64 33`
JWT_SIGNING_SECRET=""

# base URL, where the app is hosted - change this! (NO TRAILING SLASHES)
BASE_URL="http://localhost:5173"

# the code for emojicache is available at https://www.val.town/x/webdev03/emojicache
# an xoxb token with the emoji:read permission needs to be added to the emojicache instance 
PUBLIC_EMOJI_CACHE_GET_URL="https://<add-here>.val.run/"
EMOJI_CACHE_UPDATE_URL="https://<add-here>.val.run/" # !! this is different from the above !!
# this key is the `X_TOKEN` environment variable that you added to the emojicache instance
# when a new sticker is added, the emoji cache is reset
EMOJI_CACHE_UPDATE_TOKEN="<add here>" 

